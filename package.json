{
  "name": "nutmeg",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "description": "Arcade football for the browser (codename Nutmeg)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:size": "node scripts/check-size.ts",
    "check:licences": "node scripts/check-licences.ts",
    "balance": "vitest run --config balance/vitest.config.ts",
    "balance:report": "node scripts/balance-report.ts",
    "e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "screenshots:match": "playwright test e2e/match-shots.spec.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0",
    "@babylonjs/materials": "9.31.0"
  },
  "devDependencies": {
    "@babylonjs/inspector": "9.31.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "meshoptimizer": "1.3.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
